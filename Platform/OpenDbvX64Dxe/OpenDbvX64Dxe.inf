[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = OpenDbvX64Dxe
  FILE_GUID      = 87654321-4321-4321-4321-CBA987654321
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = OpenDbvX64EntryPoint

[Sources]
  OpenDbvX64Dxe.c

[Packages]
  OpenCorePkg/OpenCorePkg.dec
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib
  OcMemoryLib
  PrintLib
  UefiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  OcBootManagementLib
  OcCompressionLib
  OcDbtLib
  OcAppleKernelLib
  OcMachoLib
  OcDeviceTreeLib
  OcVirtualFsLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid
  gOcBootEntryProtocolGuid

[Depex]
  TRUE

[BuildOptions]
  CLANGPDB:*_*_*_CC_FLAGS = -Wno-deprecated-non-prototype
  GCC:*_CLANGDWARF_*_CC_FLAGS = -Wno-deprecated-non-prototype